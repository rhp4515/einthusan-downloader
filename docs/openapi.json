{
  "openapi": "3.1.0",
  "info": {
    "title": "einthusan-downloader API",
    "description": "Job-based API for downloading a movie from Einthusan and importing it into Radarr.\n\nTypical flow:\n1. `POST /api/v1/movies` with the Einthusan URL — returns a job in `resolving`, which becomes `awaiting_verification` once the TMDB match is known.\n2. Optionally `PATCH /api/v1/jobs/{job_id}` to correct the TMDB match.\n3. `POST /api/v1/jobs/{job_id}/download` to start the download and import.\n4. Poll `GET /api/v1/jobs/{job_id}` until `status` is `done` or `error`.\n\nEvery request except `/api/v1/health` requires the `X-Api-Key` header. Errors share the shape `{\"error\": {\"code\": ..., \"message\": ...}}`, where `code` is stable and safe to branch on.",
    "version": "1"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/movies": {
      "post": {
        "summary": "Create Movie",
        "operationId": "create_movie_api_v1_movies_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMovieRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobOut"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-Api-Key header (code: `unauthorized`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Not a valid Einthusan movie URL (code: `invalid_url`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/api/v1/jobs": {
      "get": {
        "summary": "List Jobs",
        "operationId": "list_jobs_api_v1_jobs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/JobOut"
                  },
                  "type": "array",
                  "title": "Response List Jobs Api V1 Jobs Get"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-Api-Key header (code: `unauthorized`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/api/v1/jobs/{job_id}": {
      "get": {
        "summary": "Get Job",
        "operationId": "get_job_api_v1_jobs__job_id__get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobOut"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-Api-Key header (code: `unauthorized`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "404": {
            "description": "No job with that id (code: `job_not_found`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Patch Job",
        "operationId": "patch_job_api_v1_jobs__job_id__patch",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchJobRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobOut"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-Api-Key header (code: `unauthorized`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "404": {
            "description": "No job with that id (code: `job_not_found`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "409": {
            "description": "Job is not in `awaiting_verification` (code: `invalid_state`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "tmdb_id is not one of the job's candidates (code: `tmdb_not_in_candidates`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete Job",
        "operationId": "delete_job_api_v1_jobs__job_id__delete",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "Missing or invalid X-Api-Key header (code: `unauthorized`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "404": {
            "description": "No job with that id (code: `job_not_found`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{job_id}/download": {
      "post": {
        "summary": "Start Download",
        "operationId": "start_download_api_v1_jobs__job_id__download_post",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobOut"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-Api-Key header (code: `unauthorized`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "404": {
            "description": "No job with that id (code: `job_not_found`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "409": {
            "description": "Job is not in `awaiting_verification` (code: `invalid_state`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "502": {
            "description": "Radarr rejected the request (codes: `radarr_unavailable`, `import_failed`, `download_failed`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateMovieRequest": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url",
            "description": "Einthusan movie page URL"
          }
        },
        "type": "object",
        "required": [
          "url"
        ],
        "title": "CreateMovieRequest"
      },
      "ErrorOut": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthOut": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "HealthOut"
      },
      "JobOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "state": {
            "type": "string",
            "enum": [
              "resolving",
              "resolve_failed",
              "awaiting_verification",
              "downloading",
              "importing",
              "done",
              "error"
            ],
            "title": "State"
          },
          "einthusan_url": {
            "type": "string",
            "title": "Einthusan Url"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/TmdbCandidateOut"
            },
            "type": "array",
            "title": "Candidates",
            "default": []
          },
          "selected_tmdb_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Selected Tmdb Id"
          },
          "progress": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProgressOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ResultOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorOut"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "state",
          "einthusan_url"
        ],
        "title": "JobOut"
      },
      "PatchJobRequest": {
        "properties": {
          "tmdb_id": {
            "type": "integer",
            "title": "Tmdb Id"
          }
        },
        "type": "object",
        "required": [
          "tmdb_id"
        ],
        "title": "PatchJobRequest"
      },
      "ProgressOut": {
        "properties": {
          "downloaded_bytes": {
            "type": "integer",
            "title": "Downloaded Bytes"
          },
          "total_bytes": {
            "type": "integer",
            "title": "Total Bytes"
          },
          "percent": {
            "type": "number",
            "title": "Percent"
          },
          "speed_bps": {
            "type": "number",
            "title": "Speed Bps"
          },
          "eta_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Eta Seconds"
          }
        },
        "type": "object",
        "required": [
          "downloaded_bytes",
          "total_bytes",
          "percent",
          "speed_bps"
        ],
        "title": "ProgressOut"
      },
      "ResultOut": {
        "properties": {
          "file": {
            "type": "string",
            "title": "File"
          },
          "radarr_movie_id": {
            "type": "integer",
            "title": "Radarr Movie Id"
          },
          "tmdb_id": {
            "type": "integer",
            "title": "Tmdb Id"
          }
        },
        "type": "object",
        "required": [
          "file",
          "radarr_movie_id",
          "tmdb_id"
        ],
        "title": "ResultOut"
      },
      "TmdbCandidateOut": {
        "properties": {
          "tmdb_id": {
            "type": "integer",
            "title": "Tmdb Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "year": {
            "type": "integer",
            "title": "Year"
          },
          "tmdb_url": {
            "type": "string",
            "title": "Tmdb Url"
          },
          "poster_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Poster Url"
          }
        },
        "type": "object",
        "required": [
          "tmdb_id",
          "title",
          "year",
          "tmdb_url"
        ],
        "title": "TmdbCandidateOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "description": "Static API key issued via the EINTHUSAN_API_KEY environment variable.",
        "in": "header",
        "name": "X-Api-Key"
      }
    }
  }
}
